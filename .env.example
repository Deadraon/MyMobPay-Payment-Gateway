# ── Supabase Configuration ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── Admin Console Authentication ───────────────────────────
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_TOTP_SECRET=YOUR_ADMIN_TOTP_SECRET_BASE32

# ── Multi-Provider Email Routing System ─────────────────────
# Stream 1: SendPulse (Primary for OTP Verification & Magic Links)
SENDPULSE_SMTP_USER=your_sendpulse_login_email
SENDPULSE_SMTP_PASS=your_sendpulse_smtp_password
# SENDPULSE_SMTP_PORT=465
# SENDPULSE_SMTP_HOST=smtp-pulse.com

# Stream 2: Resend (Primary for New Merchant Signup & Welcome)
RESEND_API_KEY=re_your_resend_api_key

# Stream 3: Brevo (Primary for Transaction Receipts & Invoices)
BREVO_SMTP_USER=your_brevo_login_email
BREVO_SMTP_KEY=your_brevo_smtp_key_or_master_password
# BREVO_SMTP_PORT=587
# BREVO_SMTP_HOST=smtp-relay.brevo.com

# General / Fallback Default SMTP & Sender Identity
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM="MyMobPay Support" <noreply@mymob.tech>

# ── Application URL ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://mymob.tech

# ── Optional: Fallback Default Receiving UPI ID ─────────────
NEXT_PUBLIC_DEFAULT_UPI_ID=yourname@okaxis

# ── WhatsApp Gateway Integration ─────────────────────────────
WHATSAPP_GATEWAY_URL=https://your-tunnel-or-cloud-gateway.com
WHATSAPP_GATEWAY_SESSION_ID=irn8se
WHATSAPP_GATEWAY_API_KEY=your_api_key_here

# ── Instagram AI Agent Integration (@mymobpay) ───────────────
INSTAGRAM_VERIFY_TOKEN=mymobpay_ig_secret_2026
INSTAGRAM_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
GEMINI_API_KEY=your_gemini_api_key_here
