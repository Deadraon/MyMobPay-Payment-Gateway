# ==============================================================================
# ⚡ MyMobPay SaaS Platform — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local and populate with your credentials.
# ==============================================================================

# ── 1. SUPABASE CORE (Database, Authentication & Storage) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
# Optional alias used in some scripts/libraries:
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── 2. PLATFORM URLS & IDENTIFIERS ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://mymobpay.tech
NEXT_PUBLIC_SITE_URL=https://mymobpay.tech
# Fallback platform API key used for internal checkout orders & subscriptions
NEXT_PUBLIC_PLATFORM_API_KEY=677d9312-a53f-4b96-815f-53e0eee1b292
PLATFORM_API_KEY=677d9312-a53f-4b96-815f-53e0eee1b292
# Optional default receiving UPI VPA when a merchant does not set one:
NEXT_PUBLIC_DEFAULT_UPI_ID=yourname@okaxis

# ── 3. ADMIN CONSOLE & NOTIFICATIONS (Integrated with your Admin Email) ──────
# Access to the Admin Console is granted based on your logged-in merchant email.
# When you log in with these emails, the Admin Console unlocks in your dashboard:
ADMIN_EMAILS=admin@mymobpay.tech,chauhankunal695@gmail.com
ADMIN_EMAIL=admin@mymobpay.tech

# Target email for admin notifications (disputes, fraud alerts, system health):
ADMIN_NOTIFICATION_EMAIL=alerts@mymobpay.tech
ADMIN_ALERT_EMAIL=alerts@mymobpay.tech

# Internal API guard: Secret token required for backend /api/admin/* endpoints
ADMIN_API_SECRET=your_admin_api_secret_key_here
ADMIN_SESSION_SECRET=your_admin_session_signing_secret_here
ADMIN_TOTP_SECRET=YOUR_ADMIN_TOTP_SECRET_BASE32

# ── 4. BACKGROUND CRON & AUTOMATED SETTLEMENT JOBS ───────────────────────────
# Bearer token required for triggering scheduled cron jobs (/api/cron/*):
CRON_SECRET=your_cron_job_secret_key_here

# ── 5. DISTRIBUTED EDGE RATE LIMITER & KV (Upstash Redis / Vercel KV) ─────────
# Protects checkout routes and public APIs from bot floods and DDoS attacks:
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
# Vercel KV aliases (if deployed with Vercel KV integration):
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── 6. MULTI-PROVIDER TRANSACTIONAL EMAIL ENGINE ─────────────────────────────
# Rail 0: Mailflare (PRIMARY — Self-Hosted at email.mymobpay.tech | Unlimited own-domain sends)
# Generates outbound emails via REST API (Port 443 — Cloudflare CDN friendly)
# Get your API key from: email.mymobpay.tech/settings/api-keys
# Get your Mailbox ID from the URL at email.mymobpay.tech (e.g. /m/<mailboxId> or browser console)
MAILFLARE_SMTP_HOST=email.mymobpay.tech
MAILFLARE_SMTP_PORT=587
MAILFLARE_SMTP_USER=noreply@mymobpay.tech
MAILFLARE_SMTP_PASS=your_mailflare_api_key_here
MAILFLARE_MAILBOX_ID=your_mailflare_mailbox_id_here
MAILFLARE_SUPPORT_MAILBOX_ID=your_support_mailbox_id_here
MAILFLARE_FROM="MyMobPay <noreply@mymobpay.tech>"
MAILFLARE_AUTH_FROM="MyMobPay Security <noreply@mymobpay.tech>"
MAILFLARE_BILLING_FROM="MyMobPay Billing <noreply@mymobpay.tech>"
MAILFLARE_SUPPORT_FROM="Support team MyMobPay <support@mymobpay.tech>"
SUPPORT_EMAIL="support@mymobpay.tech"

# Rail 1: SendPulse (Primary for Monthly Statements, Tax Invoices & Subscription Receipts)
SENDPULSE_SMTP_USER=your_sendpulse_login_email
SENDPULSE_SMTP_PASS=your_sendpulse_smtp_password
SENDPULSE_SMTP_PORT=465
SENDPULSE_SMTP_HOST=smtp-pulse.com
SENDPULSE_FROM="MyMobPay Billing <billing@mymobpay.tech>"

# Rail 2: Brevo (High-reliability fallback for Auth OTPs & Security alerts)
BREVO_SMTP_USER=your_brevo_smtp_user
BREVO_SMTP_KEY=your_brevo_smtp_key_here
BREVO_SMTP_PORT=587
BREVO_SMTP_HOST=smtp-relay.brevo.com

# Rail 3: Resend (Fast REST API & SMTP delivery)
RESEND_API_KEY=re_your_resend_api_key_here
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=

# Rail 4: EmailLabs (300/day free SMTP relay)
EMAILLABS_SMTP_USER=your_emaillabs_app_key
EMAILLABS_SMTP_PASS=your_emaillabs_secret
EMAILLABS_SMTP_HOST=smtp-relay.emaillabs.net.pl
EMAILLABS_SMTP_PORT=587

# Rail 5: Unitpost (REST API / SMTP)
UNITPOST_API_KEY=your_unitpost_api_key_here
UNITPOST_SMTP_USER=unitpost
UNITPOST_SMTP_PASS=your_unitpost_password_here
UNITPOST_SMTP_HOST=smtp.unitpost.com
UNITPOST_SMTP_PORT=587

# Rail 6: Maileroo (3,000/mo free transactional tier)
MAILEROO_API_KEY=your_maileroo_api_key_here
MAILEROO_SMTP_USER=your_maileroo_smtp_username
MAILEROO_SMTP_PASS=your_maileroo_smtp_password
MAILEROO_SMTP_HOST=smtp.maileroo.com
MAILEROO_SMTP_PORT=587

# Dedicated Senders / Purpose-Specific Identities:
SMTP_FROM="MyMobPay Support" <noreply@mymobpay.tech>
AUTH_FROM="MyMobPay Security" <auth@mymobpay.tech>
BILLING_FROM="MyMobPay Billing" <trx@mymobpay.tech>

# ── 7. WHATSAPP GATEWAY INTEGRATION ──────────────────────────────────────────
# Primary: Self-Hosted Baileys WhatsApp Gateway (wa.mymobpay.tech)
WHATSAPP_GATEWAY_URL=https://wa.mymobpay.tech
WHATSAPP_GATEWAY_SESSION_ID=irn8se
WHATSAPP_GATEWAY_API_KEY=your_whatsapp_gateway_api_key_here

# Secondary / Fallback: Official Meta Cloud WhatsApp API (Optional)
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here

# ── 8. AI COPILOT & AUTOMATIONS ──────────────────────────────────────────────
# Backboard AI Intelligence Engine (Persistent Merchant Memory & Support)
BACKBOARD_API_KEY=your_backboard_api_key_here
BACKBOARD_ASSISTANT_ID=your_backboard_assistant_id_here

# Google Gemini API (Multimodal reasoning & intelligence)
GEMINI_API_KEY=your_gemini_api_key_here

# Instagram Direct Messaging AI Bot (@mymobpay)
INSTAGRAM_VERIFY_TOKEN=mymobpay_ig_secret_2026
INSTAGRAM_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here

# ── 9. OPTIONAL CHANNELS & 3RD-PARTY AUTH (Fallback OTP Rails) ───────────────
# Telegram Bot for OTPs and Emergency Merchant Alerts:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=mymobpay_bot

# Firebase Phone Auth for SMS OTP delivery:
FIREBASE_API_KEY=your_firebase_web_api_key_here

# ── 10. WEBHOOK & INTERNAL INTEGRATION SECRETS ────────────────────────────────
# Default HMAC webhook signing secret for internal verification testing:
WEBHOOK_SECRET=your_default_webhook_secret_here
MYMOBPAY_SECRET_KEY=sec_live_your_api_key_here
MYMOBPAY_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ── 11. SEARCH ENGINE & WEBMASTER VERIFICATION ────────────────────────────────
NEXT_PUBLIC_GSC_VERIFICATION=your_google_site_verification_code_here
NEXT_PUBLIC_BING_VERIFICATION=your_bing_verification_code_here
