# ── Supabase Configuration ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ── Admin Console Authentication ───────────────────────────
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_TOTP_SECRET=YOUR_ADMIN_TOTP_SECRET_BASE32

# ── Transaction & Notification Email (SMTP) ─────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your_smtp_api_key_or_password
SMTP_FROM="MyMobPay Support" <noreply@example.com>

# ── Application URL (Localhost) ─────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional: Fallback Default Receiving UPI ID ─────────────
NEXT_PUBLIC_DEFAULT_UPI_ID=yourname@okaxis
